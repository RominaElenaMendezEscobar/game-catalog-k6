{
  "name": "smoke",
  "description": "1 user for 1 minute: checks that the API works before adding load (~30 requests).",
  "queries_file": "queries.json",
  "endpoint": "/search",
  "think_time_seconds": 1,
  "request_timeout": "30s",
  "executor": {
    "executor": "constant-vus",
    "vus": 1,
    "duration": "1m"
  },
  "thresholds": {
    "http_req_failed": ["rate<0.01"],
    "http_req_duration": ["p(95)<5000"]
  }
}